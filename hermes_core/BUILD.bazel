# ── UniFFI Swift bindings ────────────────────────────────────────────
# Generated from the macOS archive: the exported surface has no
# cfg(target_os) branches, so the bindings are identical for every Apple
# target, and the host archive is the one the macOS tests already need.
# uniffi 0.31.2 names the files after [bindings.swift] module_name, so no
# renaming is needed. Bindgen runs in a scratch dir because it also writes a
# .modulemap this rule does not declare (rules_swift synthesizes its own).

genrule(
    name = "swift_bindings",
    srcs = CORE_SRCS + [":libhermes_core_macos_arm64"],
    outs = [
        "bindings/swift/HermesCore.swift",
        "bindings/swift/HermesCoreFFI.h",
    ],
    cmd = """
        set -euo pipefail
        SWIFT_OUT="$$(pwd)/$(location bindings/swift/HermesCore.swift)"
        HEADER_OUT="$$(pwd)/$(location bindings/swift/HermesCoreFFI.h)"
        LIB="$$(pwd)/$(location :libhermes_core_macos_arm64)"
        GEN_DIR="$$(mktemp -d)"
        trap 'rm -rf "$$GEN_DIR"' EXIT
        ROOT="$$(dirname $(location Cargo.toml))"
        cd "$$ROOT"
        cargo run --bin uniffi-bindgen -- generate \\
            --library "$$LIB" \\
            --language swift \\
            --out-dir "$$GEN_DIR"
        mkdir -p "$$(dirname "$$SWIFT_OUT")"
        cp "$$GEN_DIR/HermesCore.swift" "$$SWIFT_OUT"
        cp "$$GEN_DIR/HermesCoreFFI.h" "$$HEADER_OUT"
    """,
    tags = ["local"],
    target_compatible_with = APPLE_ONLY,
    visibility = ["//visibility:public"],
)

# ── UniFFI Kotlin bindings ───────────────────────────────────────────
# Bindgen embeds the .so basename as the JNA library name, and the Bazel out
# name is not libhermes_core.so — stage a correctly named copy and point
# --library at it, then copy the generated .kt to the declared out.

genrule(
    name = "kotlin_bindings",
    srcs = CORE_SRCS + [":libhermes_core_android_arm64"],
    outs = ["bindings/uniffi/hermes_core/hermes_core.kt"],
    cmd = """
        set -euo pipefail
        OUT="$$(pwd)/$@"
        LIB_SRC="$$(pwd)/$(location :libhermes_core_android_arm64)"
        LIB_DIR="$$(mktemp -d)"
        OUT_DIR="$$(mktemp -d)"
        trap 'rm -rf "$$LIB_DIR" "$$OUT_DIR"' EXIT
        LIB="$$LIB_DIR/libhermes_core.so"
        cp "$$LIB_SRC" "$$LIB"
        ROOT="$$(dirname $(location Cargo.toml))"
        cd "$$ROOT"
        cargo run --bin uniffi-bindgen -- generate \\
            --library "$$LIB" \\
            --language kotlin \\
            --out-dir "$$OUT_DIR"
        mkdir -p "$$(dirname "$$OUT")"
        cp "$$OUT_DIR/uniffi/hermes_core/hermes_core.kt" "$$OUT"
    """,
    tags = ["local"],
    visibility = ["//visibility:public"],
)