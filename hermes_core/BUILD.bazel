# ── hermes_core native libraries ─────────────────────────────────────
# All cargo genrules use tags=["local"] to bypass the Bazel sandbox and reuse
# the crate's own target/ (same boundary just_nutrients_official_app uses —
# no rules_rust on day 1). iOS genrules are NOT created here (T15).

CORE_SRCS = glob(
    [
        "src/**/*.rs",
        "Cargo.toml",
        "Cargo.lock",
        "uniffi-bindgen.rs",
        "uniffi.toml",
    ],
    allow_empty = False,
)

# Capture absolute outs before cd into the crate tree: $@ is relative to the
# execroot; after cd it would resolve incorrectly.

genrule(
    name = "libhermes_core_android_arm64",
    srcs = CORE_SRCS,
    outs = ["libhermes_core_android_arm64.so"],
    cmd = """
        set -euo pipefail
        OUT="$$(pwd)/$@"
        export ANDROID_NDK_HOME="$${ANDROID_NDK_HOME:-/opt/android-ndk}"
        NDK_BIN="$$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin"
        ROOT="$$(dirname $(location Cargo.toml))"
        cd "$$ROOT"
        # Reuse the crate's own target/ for incremental local builds.
        # Toolchain passed via --config (JN pattern TD10): the API-suffixed
        # clang/llvm-ar names are what let a C/asm dependency (ring,
        # aws-lc-rs) survive a cold cross build — cc-rs otherwise fails with
        # "failed to find tool".
        cargo build --release --target aarch64-linux-android \\
            --config "target.aarch64-linux-android.linker='$$NDK_BIN/aarch64-linux-android24-clang'" \\
            --config "target.aarch64-linux-android.ar='$$NDK_BIN/llvm-ar'" \\
            --config "env.CC_aarch64_linux_android='$$NDK_BIN/aarch64-linux-android24-clang'" \\
            --config "env.AR_aarch64_linux_android='$$NDK_BIN/llvm-ar'"
        mkdir -p "$$(dirname "$$OUT")"
        cp "target/aarch64-linux-android/release/libhermes_core.so" "$$OUT"
    """,
    tags = ["local"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "libhermes_core_android_armv7",
    srcs = CORE_SRCS,
    outs = ["libhermes_core_android_armv7.so"],
    cmd = """
