            --config "target.armv7-linux-androideabi.linker='$$NDK_BIN/armv7a-linux-androideabi24-clang'" \\
            --config "target.armv7-linux-androideabi.ar='$$NDK_BIN/llvm-ar'" \\
            --config "env.CC_armv7_linux_androideabi='$$NDK_BIN/armv7a-linux-androideabi24-clang'" \\
