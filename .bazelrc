# hermo — Bazel config, copied structurally from just_nutrients_official_app
# (READ-ONLY reference). Guards keep this laptop alive during full builds.

# Android (primary on Linux)
build:android --platforms=//platforms:android_arm64 --extra_toolchains=@androidndk//:all
build:android_armv7 --platforms=//platforms:android_armv7 --extra_toolchains=@androidndk//:all
build:android_x86_64 --platforms=//platforms:android_x86_64 --extra_toolchains=@androidndk//:all

common --enable_bzlmod

# Build environment the Cargo genrules and SDK discovery rely on.
build --action_env=PATH --action_env=HOME --action_env=ANDROID_NDK_HOME
build --action_env=ANDROID_HOME --action_env=ANDROID_SDK_ROOT
build --action_env=CARGO_HOME --action_env=RUSTUP_HOME

# rules_java toolchains: JDK 25's ct.sym breaks turbine_direct_graal; build
# host java tools against 21 (Android app targets arrive in T6 — keep the
# guards now so they are in place).
build --java_language_version=21
build --tool_java_language_version=21
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21

# Laptop guard: this box froze once on a full build. Cap parallelism.
build --jobs=4
build --worker_max_instances=2
startup --host_jvm_args=-Xmx4g
# KotlinCompile worker cap (JN guard).
build --strategy=KotlinCompile=worker --worker_max_instances=KotlinCompile=1

# Android packaging configs (T6): rules_android 0.7 (starlark) ignores
# --fat_apk_cpu for aar_import native-lib extraction; the per-target-platform
# cc toolchain comes from rules_android_ndk and the ABI from
# --android_platforms. Device = arm64, emulator = x86_64.
build:device  --android_platforms=//platforms:android_arm64 --fat_apk_cpu=arm64-v8a --extra_toolchains=@androidndk//:all
build:emulator --android_platforms=//platforms:android_x86_64 --fat_apk_cpu=x86_64 --extra_toolchains=@androidndk//:all

# Low-memory profile for the NDK-toolchain builds on this laptop.
build:lowmem --jobs=2 --worker_max_instances=1
build:lowmem --strategy=KotlinCompile=worker --worker_max_instances=KotlinCompile=1

# Apple configs. ANDROID_HOME is blanked for repo rules so rules_android emits
# its empty SDK repo instead of failing on a Mac whose SDK has no platforms.
build:apple --repo_env=ANDROID_HOME=

# Host config for swift_test targets: they run on this Mac directly, no simulator.
build:macos_host --config=apple --macos_minimum_os=26.0

# iOS Simulator config for the app and simulator-only libraries. The simulator
# device and runtime are per machine: set --ios_simulator_device and
# --ios_simulator_version in user.bazelrc.
build:ios_sim --config=apple --ios_multi_cpus=sim_arm64 --ios_minimum_os=26.0

# iOS device config (arm64); no signing is configured yet.
build:ios_device --config=apple --ios_multi_cpus=arm64 --ios_minimum_os=26.0

# Per-machine flags (simulator choice, local workarounds). Untracked.
try-import %workspace%/user.bazelrc
