load("//platforms:apple.bzl", "APPLE_ONLY")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")

swift_library(
    name = "HermoApp",
    srcs = glob(["*.swift"]),
    module_name = "HermoApp",
    target_compatible_with = APPLE_ONLY,
    deps = [
        "//ios/Sources/HermesCore",
        "//ios/Sources/HermoFeatures",
        "//ios/Sources/HermoLogic",
        "//ios/Sources/HermoUI",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

ios_application(
    name = "hermo",
    bundle_id = "sh.mo",
    families = ["iphone"],
    minimum_os_version = "26.0",
    infoplists = [":Info.plist"],
    visibility = ["//visibility:public"],
    deps = [":HermoApp"],
)
