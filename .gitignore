# Local-only docs: plans, task files, notes, handoffs.
# Everything markdown stays out of the public repo except the README.
*.md
!README.md

# Rust / Cargo
/target/
**/target/

# Secrets / local auth
.env
.env.*
*.pem
*.keystore
*.jks
# ...except the Android DEBUG signing key: it is the standard, publicly known
# `androiddebugkey`/`android` pair with no authority anywhere, and the APK
# build (`bazel build //android/app:app`) needs it present. Regenerate it any
# time with `scripts/make_debug_keystore.sh`. Never put a release key here.
!android/app/debug.keystore

# Bazel
/bazel-*
**/bazel-*

# Local tooling
.venv-tools/

# Secrets: env files, keys, cookies / token jars
.env
.env.*
*.pem

# OS / editor
.DS_Store
*.swp

# Python
__pycache__/
*.pyc
